# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '17.0'
prepare_react_native_project!

# @react-native-firebase: Firebase через CocoaPods, не через SPM — SPM-вариант
# несовместим со статической линковкой этого проекта (дубли символов).
$RNFirebaseDisableSPM = true
# Аналитика без рекламного идентификатора (IDFA): модуль IdentitySupport не
# подключается, AdSupport не линкуется — в App Store не нужно объяснять
# использование IDFA и запрашивать разрешение на отслеживание.
$RNFirebaseAnalyticsWithoutAdIdSupport = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AgeevApp' do
  config = use_native_modules!

  # Swift-подам Firebase нужны module maps их Objective-C зависимостей при
  # статической линковке.
  pod 'GoogleUtilities', :modular_headers => true

  # Firebase Analytics (@react-native-firebase) при статической линковке:
  # Swift-подам Firebase нужны module maps их Objective-C зависимостей.
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  # Crashlytics тянет Swift-под FirebaseSessions — ему тоже нужны module maps.
  pod 'PromisesObjC', :modular_headers => true
  pod 'FirebaseRemoteConfigInterop', :modular_headers => true
  pod 'FirebaseSessions', :modular_headers => true
  pod 'FirebaseCrashlytics', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Xcode 27 считает ошибкой IPHONEOS_DEPLOYMENT_TARGET < 15.0 у старых подов
    # (nanopb, GoogleDataTransport, SDWebImage, ...) — поднимаем до 15.1.
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |c|
        v = c.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1' if v && v.to_f < 15.1
      end
    end
  end
end
